{
  "name": "shererp-cloud-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
