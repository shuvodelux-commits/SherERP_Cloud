{
  "name": "shererp-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "audit": "node scripts/audit-source.mjs legacy/source",
    "verify:source": "node scripts/verify-source.mjs legacy/source docs/baseline/source-manifest.json",
    "build:frontend:raw": "node scripts/build-frontend.mjs legacy/source dist",
    "build:frontend": "npm run build:frontend:raw && node scripts/patch-rpc.mjs dist/index.html",
    "inventory:schema": "node scripts/inventory-schema.mjs legacy/source/Config.gs",
    "catalog:dry-run": "node scripts/dry-run-catalog.mjs",
    "party:dry-run": "node scripts/dry-run-party.mjs",
    "test:m01:browser": "node --test qa/m01-browser.spec.mjs qa/m01-print-flow.spec.mjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.65.1"
  }
}
