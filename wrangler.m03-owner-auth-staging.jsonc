{
  "name": "shererp-owner-pilot-release-candidate",
  "main": "src/m03-owner-redemption-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "frontend/owner-auth",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "owner-candidate-control-fixture",
      "database_id": "00000000-0000-4000-8000-000000000091",
      "migrations_dir": "staging-migrations/platform-onboarding",
      "remote": false
    },
    {
      "binding": "PLATFORM_PILOT_DB",
      "database_name": "owner-candidate-shop-fixture",
      "database_id": "00000000-0000-4000-8000-000000000092",
      "migrations_dir": "staging-migrations/shop-identity",
      "remote": false
    }
  ],
  "ratelimits": [
    {
      "name": "OWNER_INGRESS",
      "namespace_id": "657091",
      "simple": {"limit": 20, "period": 60}
    }
  ]
}
