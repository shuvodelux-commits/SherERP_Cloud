{
  "name": "shererp-m03-platform-auth-local-test",
  "main": "src/m03-private-platform-auth-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PLATFORM_AUTH_SCOPE": "private-platform-auth",
    "PLATFORM_AUTH_ORIGIN": "https://platform.example.test",
    "PLATFORM_CLIENT_ID": "123-fixture.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "frontend/platform-auth",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "shererp-m03-platform-auth-local-test",
      "database_id": "00000000-0000-4000-8000-000000000080",
      "migrations_dir": "staging-migrations/platform-auth",
      "remote": false
    }
  ],
  "ratelimits": [
    {
      "name": "PLATFORM_INGRESS",
      "namespace_id": "657080",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
