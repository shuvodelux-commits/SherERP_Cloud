{
  "name": "shererp-cloud-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shererp-operational-staging-20261118",
      "database_id": "74102df7-dd31-4999-81d5-69bca42f0424",
      "migrations_dir": "migrations"
    },
    {
      "binding": "HISTORY_ARCHIVE",
      "database_name": "shererp-legacy-history-staging-20261118",
      "database_id": "19190fd2-1f5e-4e8a-a062-bd7a0cbf3d96"
    }
  ]
}
