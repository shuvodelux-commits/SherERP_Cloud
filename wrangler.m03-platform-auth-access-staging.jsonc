{
  "name": "admin-hisabiq",
  "account_id": "ac66126a5dc7c2f21ae5c146341a5dfb",
  "main": "src/m03-access-platform-auth-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PLATFORM_AUTH_SCOPE": "private-platform-auth",
    "PLATFORM_AUTH_ORIGIN": "https://admin-hisabiq.agnishuvo.workers.dev"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/platform-auth/index.html", "**/platform-auth/platform-auth.css", "**/platform-auth/platform-auth.js"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "shererp-platform-control-staging",
      "database_id": "957c0870-d58e-4efc-aea9-807f8fe18c56",
      "migrations_dir": "staging-migrations/platform-auth",
      "remote": false
    }
  ],
  "ratelimits": [
    {
      "name": "PLATFORM_INGRESS",
      "namespace_id": "658957",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
