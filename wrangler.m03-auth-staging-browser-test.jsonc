{
  "name": "shererp-m03-staging-auth-local-test-only",
  "main": "src/m03-auth-staging-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "vars": {
    "M03_AUTH_SCOPE": "synthetic-workerd-only",
    "M03_AUTH_D1_UUID": "00000000-0000-0000-0000-000000000022"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shererp-m03-staging-auth-local-test-only",
    "database_id": "00000000-0000-0000-0000-000000000022",
    "migrations_dir": "migrations"
  }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
